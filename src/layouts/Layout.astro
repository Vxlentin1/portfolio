---
import '../styles/global.css';
import { site } from '../data/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = `Portfolio de ${site.name} — ingénieur systèmes & réseaux, alternance chez Koesio. Cybersécurité, infrastructure, certifié Cisco CCNA & Fortinet.`,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.pathname;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <meta name="keywords" content="Valentin Moyse, Ingénieur Systèmes Réseaux, Cybersécurité, CCNA, Fortinet, Portfolio, La Rochelle" />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#090d14" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts: IBM Plex Sans (body/headings) + JetBrains Mono (technical labels) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Set .js before paint so reveal elements hide without flashing -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#about" class="skip-link mono">Aller au contenu</a>
    <slot />

    <script>
      import { initAnimations } from '../scripts/anim';
      initAnimations();
    </script>
  </body>
</html>
