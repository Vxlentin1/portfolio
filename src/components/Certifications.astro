---
import SectionHead from './SectionHead.astro';
import { certifications } from '../data/content';

const monogram = (s: string) => s.charAt(0).toUpperCase();
---

<section class="section" id="certifications">
  <div class="wrap">
    <SectionHead n="05" label="Certifications" title="Certifications obtenues" />

    <div class="certs" data-stagger>
      {certifications.map((c, i) => (
        <article class="panel cert reveal">
          <div class="cert__top">
            <div class="cert__logo">
              {c.logo
                ? <img src={c.logo} alt={c.issuer} width="30" height="30" loading="lazy" />
                : <span class="cert__mono mono">{monogram(c.issuer)}</span>}
            </div>
            <span class="cert__ref mono">CERT/{String(certifications.length - i).padStart(2, '0')}</span>
          </div>
          <h3 class="cert__name">{c.name}</h3>
          <p class="cert__issuer mono">{c.issuer}</p>
          <p class="cert__date mono">{c.date}</p>
          {c.tags && (
            <div class="cert__tags">
              {c.tags.map((t) => <span class="tag">{t}</span>)}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .certs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 14px;
  }

  .cert { padding: 22px; display: flex; flex-direction: column; }

  .cert__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .cert__logo {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: rgba(126, 162, 211, 0.03);
  }

  .cert__mono { font-size: 1.2rem; font-weight: 600; color: var(--accent); }
  .cert__ref { font-size: 0.64rem; color: var(--ink-faint); letter-spacing: 0.08em; }

  .cert__name { font-size: 0.98rem; font-weight: 600; line-height: 1.35; margin-bottom: 8px; }
  .cert__issuer { font-size: 0.8rem; color: var(--accent); }
  .cert__date { font-size: 0.74rem; color: var(--ink-faint); margin-top: 2px; }
  .cert__tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 14px; }
</style>
