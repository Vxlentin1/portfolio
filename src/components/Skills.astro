---
import SectionHead from './SectionHead.astro';
import { skills } from '../data/content';
---

<section class="section" id="skills">
  <div class="wrap">
    <SectionHead n="04" label="Compétences" title="Modules & capacités" />

    <div class="skills">
      {skills.map((group, i) => (
        <article class="panel skill reveal">
          <header class="skill__head">
            <span class="skill__id mono">[{group.id.toUpperCase()}]</span>
            <h3 class="skill__title">{group.title}</h3>
            <span class="skill__count mono">{String(group.items.length).padStart(2, '0')}</span>
          </header>
          <div class="skill__items">
            {group.items.map((item) => <span class="tag">{item}</span>)}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .skills {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .skill { padding: 24px; }

  .skill__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line-dim);
  }

  .skill__id { font-size: 0.74rem; color: var(--accent); }
  .skill__title { font-size: 1.02rem; font-weight: 600; flex: 1; }
  .skill__count {
    font-size: 0.72rem;
    color: var(--ink-faint);
    padding: 2px 8px;
    border: 1px solid var(--line);
    border-radius: var(--r);
  }

  .skill__items { display: flex; flex-wrap: wrap; gap: 7px; }

  @media (max-width: 720px) {
    .skills { grid-template-columns: 1fr; }
  }
</style>
